[project]
requires = ["nodejs-24"]

[dev]
build = ["npm", "install"]
run = ["npm", "run", "dev"]

[deploy]
build = ["sh", "-c", "cd apps/pos-app && rm -rf android/app/src/main/assets/native-plugins && npm install --no-workspaces && npm run build"]
run = ["sh", "-c", "cd apps/pos-app && npm run preview -- --host 0.0.0.0 --port ${DEPLOY_RUN_PORT}"]