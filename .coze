[project]
requires = ["nodejs-24"]

[dev]
build = ["npm", "install"]
run = ["npm", "run", "dev"]

[deploy]
build = ["sh", "-c", "cd apps/pos-app && for f in $(find . -name 'package.json' -path '*native-plugins*' 2>/dev/null); do grep -q '\"version\"' \"$f\" 2>/dev/null || sed -i '1s/{/{\"name\":\"plugin\",\"version\":\"1.0.0\",/' \"$f\"; done && npm install && npm run build"]
run = ["sh", "-c", "cd apps/pos-app && npm run preview -- --host 0.0.0.0 --port ${DEPLOY_RUN_PORT}"]